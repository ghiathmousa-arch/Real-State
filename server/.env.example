# نموذج متغيرات البيئة للسيرفر — انسخه لـ server/.env وعبّي القيم الحقيقية
# (server/.env متجاهَل بـ git؛ على Render المتغيرات بتنضبط من الداشبورد)

# ── قاعدة البيانات ─────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# ── المصادقة ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Cloudinary (رفع وحذف صور العقارات) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── البريد (Resend) ───────────────────────────────────────
RESEND_API_KEY=
# عنوان المرسل لردود رسائل التواصل. مطلوب — بدونه الرد بيرجّع 500 "إعداد البريد غير مكتمل".
# ⚠️ الدومين لازم يكون موثّق (Verified) بحساب Resend، وإلا الإرسال بيفشل.
# (onboarding@resend.dev ما بيبعت إلا لإيميل صاحب حساب Resend نفسه)
MAIL_FROM="Syrian Estate <noreply@yourdomain.com>"

# ── التطوير المحلي فقط ────────────────────────────────────
# true = بيسمح لأي بورت على localhost بـ CORS. لا تضبطه بالإنتاج.
ALLOW_LOCAL_CORS=true
PORT=5000
