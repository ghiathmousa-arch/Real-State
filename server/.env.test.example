# نموذج بيئة الاختبار — انسخه لـ server/.env.test وعبّي القيم (server/.env.test متجاهَل بـ git)
# بيشتغل بـ:  $env:ENV_FILE=".env.test"; npm run dev
# السيرفر والسكريبتات بيرفضوا يشتغلوا إذا اسم القاعدة بـ MONGO_URI ما فيه "test".

# ── قاعدة البيانات ─────────────────────────────────────────
# نفس الـ cluster تبع الموقع، بس قاعدة منفصلة اسمها realestate_test (لازم الاسم مكتوب بالرابط بعد /)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/realestate_test?retryWrites=true&w=majority

# ── المصادقة ──────────────────────────────────────────────
# أي سلسلة طويلة — مش لازم تكون نفس الإنتاج
JWT_SECRET=change-me-to-a-long-random-string-for-testing
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────
# نفس حساب الإنتاج: الرفع بيشتغل (الصور الجديدة بتنرفع لنفس الحساب)، بس الحذف متوقف تحت
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ⚠️ ضروري: النسخة فيها نفس روابط صور الموقع الحي — أي حذف أو تعديل صور كان رح يمسح صور العقارات الحقيقية
DISABLE_CLOUDINARY_DELETE=true

# ── البريد (Resend) ───────────────────────────────────────
# مفتاح وهمي بالاختبار: الرد على الرسائل رح يفشل بدل ما يبعت إيميل حقيقي.
# ⚠️ ما تتركه فاضي — السيرفر بيوقع وقت التشغيل إذا المفتاح فاضي (new Resend بيرمي خطأ)
RESEND_API_KEY=re_test_dummy_key
MAIL_FROM="Syrian Estate <noreply@yourdomain.com>"

# ── التطوير المحلي ────────────────────────────────────────
ALLOW_LOCAL_CORS=true
PORT=5000
