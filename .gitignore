# تجاهل مكتبات نود في المجلد الرئيسي وفي المجلدات الفرعية
node_modules/
**/node_modules/

# تجاهل ملفات الإعدادات في كل المشروع
.env
**/.env

# تجاهل ملفات الأخطاء والسجلات
*.log
**/*.log

# تجاهل الصور داخل مجلد الرفع في السيرفر
server/uploads/*
!server/uploads/.gitkeep

# ملفات النظام
.DS_Store

# ملف أوامر التشغيل المحلي (لا يرفع على git)
RUN_COMMANDS.md

# نسخة محلية من بيانات العقارات (dump) — لا ترفع على git
props.json
